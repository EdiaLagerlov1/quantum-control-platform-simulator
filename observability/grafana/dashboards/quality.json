    {
      "type": "table",
      "title": "CI runs",
      "description": "Every CI run with its result and failing-test count.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.started_at AS \"started\", r.branch, r.event, r.conclusion AS result,\n  count(*) FILTER (WHERE t.outcome IN ('failed', 'error')) AS failed,\n  count(t.*) AS tests, r.commit_sha AS commit, r.title\nFROM ci_runs r LEFT JOIN test_results t USING (run_id)\nGROUP BY r.run_id ORDER BY r.started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failure": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    },
    {
      "type": "table",
      "title": "Failures",
      "description": "Which test failed, where, and the first line of its message.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.started_at AS \"when\", r.branch, t.test_id AS test, t.message\nFROM test_results t JOIN ci_runs r USING (run_id)\nWHERE t.outcome IN ('failed', 'error') ORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    },
    {
      "type": "table",
      "title": "Flaky candidates",
      "description": "Tests that both passed and failed across runs. Each needs an owner: real bug, bad test, or an intentional break.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT test_id AS test, count(*) AS runs,\n  count(*) FILTER (WHERE outcome IN ('failed', 'error')) AS failed\nFROM test_results GROUP BY test_id\nHAVING bool_or(outcome IN ('failed', 'error')) AND bool_or(outcome = 'passed')\nORDER BY failed DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    },
    {
      "type": "table",
      "title": "Bugs",
      "description": "Sorted by severity. In a real team this comes from Jira.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT bug_id AS id, severity, priority, status, component, title, found_by,\n  opened_on::text AS opened, fixed_on::text AS fixed FROM bugs ORDER BY status DESC, CASE severity WHEN 'Critical' THEN 1 WHEN 'High' THEN 2 WHEN 'Medium' THEN 3 ELSE 4 END, bug_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "High": {
                        "color": "red",
                        "index": 1
                      },
                      "Medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "Low": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Open": {
                        "color": "yellow",
                        "index": 0
                      },
                      "Fixed": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    }
  ]
