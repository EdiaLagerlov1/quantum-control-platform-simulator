          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE outcome IN ('failed', 'error')) AS failing FROM test_results WHERE run_id = (SELECT run_id FROM ci_runs WHERE branch = 'main' ORDER BY started_at DESC LIMIT 1)"
