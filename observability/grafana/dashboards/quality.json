{
  "uid": "quality",
  "title": "Product quality and release readiness",
  "description": "CI history, test results and bugs for the quantum control platform.",
  "tags": [
    "quality",
    "ci"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
