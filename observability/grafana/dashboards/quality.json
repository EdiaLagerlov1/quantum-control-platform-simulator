    {
      "type": "barchart",
      "title": "Test outcomes per CI run",
      "description": "One stacked bar per CI run (UTC). A red slice is a failing run; the height shows suite growth.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(r.started_at AT TIME ZONE 'UTC', 'MM-DD HH24:MI') || '  ' || r.branch AS run,\n  count(*) FILTER (WHERE t.outcome = 'passed') AS passed,\n  count(*) FILTER (WHERE t.outcome IN ('failed', 'error')) AS failed,\n  count(*) FILTER (WHERE t.outcome = 'xfailed') AS xfailed\nFROM ci_runs r JOIN test_results t USING (run_id)\nWHERE $__timeFilter(r.started_at)\nGROUP BY r.run_id ORDER BY r.started_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "xfailed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "run",
        "orientation": "vertical",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "stacking": "normal",
        "showValue": "auto",
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    },
    {
      "type": "barchart",
      "title": "CI run duration",
      "description": "Wall-clock time of each CI run (UTC). Slow pipelines delay every merge.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quality-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(r.started_at AT TIME ZONE 'UTC', 'MM-DD HH24:MI') || '  ' || r.branch AS run,\n  extract(epoch FROM r.finished_at - r.started_at)::int AS duration\nFROM ci_runs r WHERE $__timeFilter(r.started_at) ORDER BY r.started_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "run",
        "orientation": "vertical",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "stacking": "none",
        "showValue": "auto",
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quality-db"
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Details",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
