  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Release readiness: can we ship main?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
